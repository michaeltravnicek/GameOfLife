openapi: 3.0.3
info:
  title: Game of Life API
  version: 1.0.0
  description: REST API for the Game of Life leaderboard platform.
paths:
  /api/v1/admin/feedbacks/:
    get:
      operationId: v1_admin_feedbacks_retrieve
      description: All event feedback (admin only) with submitter name + attended-event
        count.
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/login/:
    post:
      operationId: v1_auth_login_create
      description: Log in via phone / username / email + password. Optional `remember`.
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/logout/:
    post:
      operationId: v1_auth_logout_create
      description: Log out the current session. Revokes the mobile token when used.
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/me/:
    get:
      operationId: v1_auth_me_retrieve
      description: 'Current authenticated user (or `{user: null}` for guests).'
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/password-reset/:
    post:
      operationId: v1_auth_password_reset_create
      description: Trigger Django's password-reset email. Generic 200 (no account
        enumeration).
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/password-reset/confirm/:
    post:
      operationId: v1_auth_password_reset_confirm_create
      description: |-
        Set a new password from the email's uid+token. Body: {uid, token, new_password}.

        The React page at /obnova-hesla/<uid>/<token>/ POSTs here.
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/profile/photo/:
    post:
      operationId: v1_auth_profile_photo_create
      description: 'Upload/replace the current user''s avatar (downscaled to 400×400).
        Multipart: `photo`.'
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/profile/update/:
    post:
      operationId: v1_auth_profile_update_create
      description: Update the current user's account + profile fields, photo, and
        favourite categories.
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      responses:
        '200':
          description: No response body
    patch:
      operationId: v1_auth_profile_update_partial_update
      description: Update the current user's account + profile fields, photo, and
        favourite categories.
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/register/:
    post:
      operationId: v1_auth_register_create
      description: Create an account (links to a leaderboard user by phone) and log
        in.
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/categories/:
    get:
      operationId: v1_categories_retrieve
      description: 'All event categories. Response: `{categories: [{id, name}]}`.'
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/checkin-events/:
    get:
      operationId: v1_checkin_events_retrieve
      description: Events the current user can check into right now (`[]` for guests).
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/events/:
    get:
      operationId: v1_events_retrieve
      description: |-
        List events with filters + offset/limit pagination.

        Params: period, city, category, q, season_id, offset, limit. Response:
        `{events, count, has_more, cities, categories}` — cities/categories on page 0 only.
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/events/{slug}/:
    get:
      operationId: v1_events_retrieve_2
      description: Full detail for a single event (hidden events are 404 for non-admin).
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/events/{slug}/checkin/:
    post:
      operationId: v1_events_checkin_create
      description: 'Submit geo-verified attendance. Body: {latitude, longitude}.'
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/events/{slug}/delete/:
    delete:
      operationId: v1_events_delete_destroy
      description: |-
        Delete an event (admin only).

        Cascades to awarded points, RSVPs, feedback and photos — leaderboard
        totals change, so the points-dependent caches are dropped.
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/events/{slug}/feedback/:
    post:
      operationId: v1_events_feedback_create
      description: Create or update the current user's 1–5 rating + comment for an
        event.
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/events/{slug}/images/:
    post:
      operationId: v1_events_images_create
      description: |-
        Attach official images to an event (admin/photographer only, downscaled on save).

        Multipart body: `images` (one or many) or a single `image`.
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/events/{slug}/rsvp/:
    post:
      operationId: v1_events_rsvp_create
      description: Toggle the current user's RSVP for an event (respects capacity).
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/events/{slug}/update/:
    patch:
      operationId: v1_events_update_partial_update
      description: Update an event (admin only). Multipart body; absent fields stay
        unchanged.
      parameters:
      - in: path
        name: slug
        schema:
          type: string
        required: true
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/events/create/:
    post:
      operationId: v1_events_create_create
      description: Create a new event (admin only). Multipart body with event fields.
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/gallery/:
    get:
      operationId: v1_gallery_retrieve
      description: |-
        Combined gallery (official + user photos), date-desc, offset/limit paginated.

        Optional ?season_id filters to photos whose event falls within that season.
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/hero/:
    get:
      operationId: v1_hero_retrieve
      description: 'Hero carousel images (absolute URLs). Response: `{hero_events:
        [...]}`.'
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/leaderboard/:
    get:
      operationId: v1_leaderboard_retrieve
      description: Season-scoped leaderboard. ?season_id=<id|active|all> (default
        active), ?limit=N.
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/photos/:
    post:
      operationId: v1_photos_create
      description: |-
        Upload a community gallery photo (admin/photographer only, downscaled on save).

        Multipart body: `image` (required), `event` (optional event slug), `caption`.
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/photos/{photo_id}/like/:
    post:
      operationId: v1_photos_like_create
      description: 'Toggle the current user''s like on a community photo. Response:
        `{liked, count}`.'
      parameters:
      - in: path
        name: photo_id
        schema:
          type: integer
        required: true
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/players/{user_id}/:
    get:
      operationId: v1_players_retrieve
      description: |-
        Public profile for a leaderboard player by id (registered or not).

        Lists the events they attended. `profile_username` is set if the player has a
        linked account (so the frontend can redirect to the full /profiles/ page).
      parameters:
      - in: path
        name: user_id
        schema:
          type: integer
        required: true
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/players/{user_id}/seasons/{season_id}/:
    get:
      operationId: v1_players_seasons_retrieve
      description: |-
        One season's events/points/rank for a leaderboard player (lazy per tab).

        Mirrors the profile season endpoint but keyed by leaderboard-user id, so it
        works for Google-Sheets players who have no account.
      parameters:
      - in: path
        name: season_id
        schema:
          type: integer
        required: true
      - in: path
        name: user_id
        schema:
          type: integer
        required: true
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/profiles/{username}/:
    get:
      operationId: v1_profiles_retrieve
      description: |-
        Public profile core: stats, rank, upcoming RSVPs, and season summaries.

        Per-season event detail is loaded lazily via `profile_season_view`.
      parameters:
      - in: path
        name: username
        schema:
          type: string
        required: true
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/profiles/{username}/seasons/{season_id}/:
    get:
      operationId: v1_profiles_seasons_retrieve
      description: One season's events/points/rank for a user (lazy-loaded per profile
        tab).
      parameters:
      - in: path
        name: season_id
        schema:
          type: integer
        required: true
      - in: path
        name: username
        schema:
          type: string
        required: true
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/seasons/:
    get:
      operationId: v1_seasons_retrieve
      description: 'All seasons for the season selector. Response: `{seasons: [...]}`.'
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/stats/:
    get:
      operationId: v1_stats_retrieve
      description: 'Global counters for the home ''about'' block. Response: `{players,
        events, points}`.'
      tags:
      - v1
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          description: No response body
components:
  securitySchemes:
    cookieAuth:
      type: apiKey
      in: cookie
      name: sessionid
    tokenAuth:
      type: apiKey
      in: header
      name: Authorization
      description: Token-based authentication with required prefix "Token"
