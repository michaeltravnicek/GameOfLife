# Loaded by Vite for production builds only (`npm run build`), so local `npm run
# dev` leaves Sentry disabled.
#
# The DSN is intentionally committed: it is embedded in the shipped JS bundle
# and readable by anyone with devtools. It is a write-only ingest key — it can
# submit events, not read them. Keeping it here rather than in Render's env
# means a build can't silently ship with error reporting switched off.
#
# EU region (ingest.de.sentry.io): event data stays in Frankfurt.
VITE_SENTRY_DSN="https://ecb0db5848144eecbfaca883a53e0364@o4511775685279744.ingest.de.sentry.io/4511775689801808"

# Historie page: the "Podpoř Game of Life" block renders only while this holds a
# value — empty string keeps the whole section hidden.
#
# Put in either a QR-platba (SPD 1.0) string, which Czech banking apps open as a
# prefilled payment:
#   SPD*1.0*ACC:CZ0000000000000000000000*AM:200.00*CC:CZK*MSG:GAME OF LIFE
# (ACC is the IBAN, AM the preset amount — drop AM to let people choose), or a
# plain donation URL if you'd rather point at a payment page.
#
# Committed like the DSN above: this string is printed as a public QR code on
# the site, so there is nothing in it a visitor can't already read off the page.
VITE_SUPPORT_QR=""
